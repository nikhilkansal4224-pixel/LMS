# ==============================================================================
# SOP (Student Operations Portal) — UPES Dehradun Environment Variables
# Configure these in your Vercel Project Settings (Settings -> Environment Variables)
# ==============================================================================

# 1. UPES Identity & Authentication Server
UPES_AUTH_URL=https://slcm.upes.ac.in/api/v1/auth/login
UPES_TOKEN_EXCHANGE_URL=https://slcm.upes.ac.in/api/v1/identity/connect/token
UPES_API_BASE_URL=https://slcm.upes.ac.in/api/v1

# 2. Live Student Dashboard Modules
UPES_PROFILE_URL=https://slcm.upes.ac.in/api/v1/student/profile
UPES_ATTENDANCE_URL=https://slcm.upes.ac.in/api/v1/student/attendance
UPES_TIMETABLE_URL=https://slcm.upes.ac.in/api/v1/student/timetable
UPES_GRADES_URL=https://slcm.upes.ac.in/api/v1/student/grades

# 3. Document & Avatar Storage Server
UPES_DOCS_BASE_URL=https://slcm.upes.ac.in
UPES_FILE_API_URL=https://slcm.upes.ac.in/edutech/documents

# 4. Optional Security Captcha (Leave empty to use built-in Neumorphic Slide-to-Verify & Math Sentinel)
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
